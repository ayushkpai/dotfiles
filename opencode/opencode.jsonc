{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "*": "ask",

    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",

    "edit": "ask",

    "bash": {
      "*": "ask",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",

      "git branch *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",

      "*": "ask"
    },

    "task": "ask",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "ask"
  }
}

